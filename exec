#!/usr/bin/env node
// const { exec, execSync } = require('child_process');
import { promisify } from 'node:util';
import { exec as execCallback } from 'node:child_process';

const exec = promisify(execCallback);

process.stdin.write('Working with exec \n');

(async () => {
	let value = process.argv[2];
	if (value === undefined) {
		console.log('No value provided: needs `a`. `b`. `c`. `d`. as argument.');
		process.exit(1);
	}
	const { stderr: ste, stdout: std } = await exec(`"./case.sh" ${value}`);
	console.log(std, ste);
	// Double quotes are used so that the space in the path is not interpreted as
	// a delimiter of multiple arguments.

	// exec('echo "The \\$HOME variable is $HOME"', (err, stdout, stderr) => {
	// 	console.log({ err, stderr, stdout });
	// 	if (err) process.exit(127);
	// 	if (stderr) process.exit(1);
	// 	if (stdout) console.log(stdout);
	// });
	// The $HOME variable is escaped in the first instance, but not in the second.
})();
